# Application name used in log output and service identification
APP_NAME=wow-dashboard-api

# Port the Go API server will bind and listen on (defaults to 7272 if unset)
PORT=7272

# Environment stage (development, staging, production)
ENV=development

# Frontend base URL used in transactional email links.
# ENV=production requires an https:// URL.
APP_BASE_URL=http://localhost:3000

# Structured logging. LOG_FORMAT can be text or json.
# If unset, development/staging default to text and production defaults to json.
LOG_FORMAT=
# Structured log level (debug, info, warn, error)
LOG_LEVEL=info

# HTTP server timeouts in seconds. All must be strictly > 0.
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10

# Maximum accepted request body size in bytes, enforced at the transport edge
# for every route (returns 413 when exceeded). Default 1 MiB (1048576) matches
# Huma's per-operation body cap. Must be >= 0; 0 disables the edge check.
REQUEST_BODY_MAX_BYTES=1048576

# Comma-separated list of allowed CORS origins.
# ENV=production enforces exact origins starting with 'https://', and rejects loopbacks, empty origins, or wildcards (*).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# PostgreSQL connection URL. Mandatory in production. Masks credentials in errors/logs.
DATABASE_URL=postgres://wow_dashboard:wow_dashboard@localhost:5432/wow_dashboard_api?sslmode=disable

# Database connection pool configurations.
# DB_MAX_CONNS must be > 0. DB_MIN_CONNS must be >= 0 and <= DB_MAX_CONNS.
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME_SECONDS=1800
DB_MAX_CONN_IDLE_TIME_SECONDS=300
DB_HEALTH_TIMEOUT_SECONDS=3
# Per-statement timeout (PostgreSQL statement_timeout) applied to every pooled
# connection so a stuck query cannot pin a connection forever. Must be > 0.
DB_STATEMENT_TIMEOUT_SECONDS=30
# How often the pool probes idle connections to prune dead ones. Must be > 0.
DB_HEALTH_CHECK_PERIOD_SECONDS=30

# Auth rate limiting. Defaults allow 10 attempts per IP per minute with burst 5.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BURST=5

# JWT authentication configurations
# JWT_ACCESS_SECRET must be at least 32 characters long.
# ENV=production forbids default secrets and rejects common placeholder substrings (case-insensitive checks for change-me, changeme, dev-only, example, secret).
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters
JWT_ISSUER=wow-dashboard-api
JWT_AUDIENCE=wow-dashboard
# Access token TTL. Must be strictly > 0.
# ENV=production restricts this strictly to between 60 and 3600 seconds (1 minute to 1 hour).
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token cookie configuration
# REFRESH_TOKEN_COOKIE_NAME must not contain spaces, semicolons, commas, equals, control characters, or non-ASCII characters.
# REFRESH_TOKEN_COOKIE_SECURE=false is only for development/staging HTTP.
# ENV=production requires REFRESH_TOKEN_COOKIE_SECURE=true (and will default to true if unset).
# If REFRESH_TOKEN_COOKIE_SAMESITE is set to 'none', REFRESH_TOKEN_COOKIE_SECURE must be true in all environments.
REFRESH_TOKEN_TTL_SECONDS=7776000
REFRESH_TOKEN_COOKIE_NAME=wow_dashboard_refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# Access token cookie configuration. The access token is delivered as an HttpOnly
# cookie (Path=/) so it is never exposed to JavaScript. Its cookie MaxAge tracks
# the refresh-session lifetime (REFRESH_TOKEN_TTL_SECONDS) so it survives access-
# token expiry; the JWT inside still expires per JWT_ACCESS_TOKEN_TTL_SECONDS and
# is re-minted on refresh. Same rules as the refresh cookie:
# ACCESS_TOKEN_COOKIE_SECURE must be true in production (defaults to true if unset),
# and SameSite=none requires SECURE=true in all environments. Set
# ACCESS_TOKEN_COOKIE_DOMAIN to a shared parent (e.g. ".example.com") when the app
# and API run on different subdomains; leave empty for host-only (dev default).
ACCESS_TOKEN_COOKIE_NAME=wow_dashboard_access_token
ACCESS_TOKEN_COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE_SAMESITE=lax
ACCESS_TOKEN_COOKIE_DOMAIN=

# Email transport. Leave EMAIL_SMTP_HOST empty to log emails to stdout
# (LogSender) — handy for local dev with no relay. Production MUST set a host.
# EMAIL_SMTP_TLS is one of: none, starttls, tls. Default port follows the mode
# (none=25, starttls=587, tls=465) when EMAIL_SMTP_PORT is left at 0.
# Local dev with the bundled Mailpit container:
#   EMAIL_SMTP_HOST=localhost
#   EMAIL_SMTP_PORT=1025
#   EMAIL_SMTP_TLS=none
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=none
# Must parse as an email address; display-name format is allowed.
EMAIL_FROM_ADDRESS=noreply@wow-dashboard.test
EMAIL_FROM_NAME=WOW Dashboard

# Observability. Leave empty to disable distributed tracing entirely (the
# default — keeps the API runnable without a collector). Point at an OTLP/HTTP
# endpoint to ship spans somewhere. The bundled local stack
# (`make observability-up`) exposes Jaeger v2 on this port:
OTEL_EXPORTER_OTLP_ENDPOINT=

# Data retention. A background job (cmd/worker) purges expired refresh tokens,
# consumed/expired auth tokens, and audit (system) events older than this many
# days. Must be > 0. Refresh and auth tokens are purged on their own expiry, not
# this window.
SYSTEM_EVENTS_RETENTION_DAYS=90
