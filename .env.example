# Application name used in log output and service identification
APP_NAME=wow-dashboard-api

# Port the Go API server will bind and listen on (defaults to 7272 if unset)
PORT=7272

# Environment stage (development, staging, production)
ENV=development

# Structured logging. LOG_FORMAT can be text or json.
# If unset, development/staging default to text and production defaults to json.
LOG_FORMAT=
# Structured log level (debug, info, warn, error)
LOG_LEVEL=info

# HTTP server timeouts in seconds. All must be strictly > 0.
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10

# Comma-separated list of allowed CORS origins.
# ENV=production enforces exact origins starting with 'https://', and rejects loopbacks, empty origins, or wildcards (*).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# PostgreSQL connection URL. Mandatory in production. Masks credentials in errors/logs.
DATABASE_URL=postgres://spec:spec@localhost:5432/wow_dashboard_api?sslmode=disable

# Database connection pool configurations.
# DB_MAX_CONNS must be > 0. DB_MIN_CONNS must be >= 0 and <= DB_MAX_CONNS.
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME_SECONDS=1800
DB_MAX_CONN_IDLE_TIME_SECONDS=300
DB_HEALTH_TIMEOUT_SECONDS=3

# Auth rate limiting. Defaults allow 10 attempts per IP per minute with burst 5.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BURST=5

# JWT authentication configurations
# JWT_ACCESS_SECRET must be at least 32 characters long.
# ENV=production forbids default secrets and rejects common placeholder substrings (case-insensitive checks for change-me, changeme, dev-only, example, secret).
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters
JWT_ISSUER=wow-dashboard-api
JWT_AUDIENCE=wow-dashboard
# Access token TTL. Must be strictly > 0.
# ENV=production restricts this strictly to between 60 and 3600 seconds (1 minute to 1 hour).
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token cookie configuration
# REFRESH_TOKEN_COOKIE_NAME must not contain spaces, semicolons, commas, equals, control characters, or non-ASCII characters.
# REFRESH_TOKEN_COOKIE_SECURE=false is only for development/staging HTTP.
# ENV=production requires REFRESH_TOKEN_COOKIE_SECURE=true (and will default to true if unset).
# If REFRESH_TOKEN_COOKIE_SAMESITE is set to 'none', REFRESH_TOKEN_COOKIE_SECURE must be true in all environments.
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_TOKEN_COOKIE_NAME=wow_dashboard_refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
