      "name": "GET /api/system-events admin list",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "const limitParam = pm.request.url.query.all().find(function (param) {",
              "  return param.key === 'limit';",
              "});",
              "const requestedLimit = Number(limitParam.value);",
              "pm.test('system events response respects requested limit', function () {",
              "  pm.expect(body).to.have.property('limit', requestedLimit);",
              "  pm.expect(body).to.have.property('events');",
              "  pm.expect(body.events).to.not.eql(null);",
              "  pm.expect(body.events).to.be.an('array');",
              "  pm.expect(body.events.length).to.be.at.most(requestedLimit);",
              "});",
              "",
              "pm.test('system events include stable public fields', function () {",
              "  body.events.forEach(function (event) {",
              "    pm.expect(event).to.include.keys(['id', 'eventType', 'message', 'metadata', 'createdAt']);",
              "    pm.expect(event.id).to.be.a('string').and.is.not.empty;",
              "    pm.expect(event.eventType).to.be.a('string').and.is.not.empty;",
              "    pm.expect(event.message).to.be.a('string');",
              "    pm.expect(event.metadata).to.not.eql(null);",
              "    pm.expect(event.metadata).to.be.an('object');",
              "    pm.expect(event.createdAt).to.be.a('string').and.is.not.empty;",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/system-events?limit=7",
