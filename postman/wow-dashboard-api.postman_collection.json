    "name": "wow-dashboard-api Black-Box Smoke",
    "description": "Newman smoke and acceptance baseline for the local wow-dashboard-api service. It exercises health, auth, admin users, system audit events, and owner-scoped projects through the public HTTP API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runSuffix')) {",
          "  const suffix = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
          "  const projectBase = pm.environment.get('projectName') || 'Newman Project';",
          "  const duplicateProjectBase = pm.environment.get('duplicateProjectName') || 'Newman Duplicate Project';",
          "  pm.environment.set('runSuffix', suffix);",
          "  pm.environment.set('projectName', `${projectBase} ${suffix}`);",
          "  pm.environment.set('duplicateProjectName', `${duplicateProjectBase} ${suffix}`);",
          "  pm.environment.set('updatedProjectName', `${projectBase} Updated ${suffix}`);",
          "  pm.environment.set('newUserEmail', `postman-user-${suffix}@example.test`);",
          "}"
        ]
      }
    }
  ],
