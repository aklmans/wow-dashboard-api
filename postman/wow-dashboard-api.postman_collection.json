    {
      "name": "GET /api/users as role=user returns 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403', function () {",
              "  pm.response.to.have.status(403);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('forbidden response has stable error envelope', function () {",
              "  pm.expect(body).to.include.keys(['code', 'message', 'request_id']);",
              "  pm.expect(body.code).to.eql('forbidden');",
              "  pm.expect(body.message).to.eql('Admin role required.');",
              "  pm.expect(body.request_id).to.be.a('string');",
