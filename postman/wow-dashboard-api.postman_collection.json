    {
      "name": "POST /api/auth/sign-in admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
              "pm.test('sign-in returns admin session', function () {",
              "  pm.expect(body).to.have.property('accessToken').that.is.a('string').and.is.not.empty;",
              "  pm.expect(body).to.have.property('user');",
              "  pm.expect(body.user).to.have.property('email', pm.environment.get('email'));",
              "  pm.expect(body.user).to.have.property('role', 'admin');",
              "});",
              "",
              "pm.test('sign-in sets an HttpOnly refresh cookie', function () {",
              "  pm.expect(setCookie).to.include('wow_dashboard_refresh_token=');",
              "  pm.expect(setCookie).to.include('HttpOnly');",
              "});",
              "",
              "const refreshCookie = setCookie.match(/wow_dashboard_refresh_token=([^;]+)/);",
              "if (refreshCookie) {",
              "  pm.environment.set('refreshCookie', refreshCookie[1]);",
              "}",
              "pm.environment.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
