    {
      "type": "timeseries",
      "title": "GC pause p95 + heap allocation rate",
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "options": {
